{
  "name": "app-20-llmchat",
  "version": "1.0.3",
  "private": false,
  "description": "React component library for LLM chat interfaces",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "cd demo && npx vite build",
    "dev:demo": "cd demo && npx vite",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yetanotherchris/app-20-llmchat.git"
  },
  "homepage": "https://yetanotherchris.github.io/app-20-llmchat",
  "bugs": {
    "url": "https://github.com/yetanotherchris/app-20-llmchat/issues"
  },
  "keywords": [
    "react",
    "chat",
    "llm",
    "ai",
    "conversation",
    "component",
    "ui",
    "react-native",
    "react-native-web"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": "^0.86.0",
    "react-native-web": "^0.21.0"
  },
  "dependencies": {
    "@legendapp/list": "^3.3.10",
    "react-native-marked": "^8.1.1",
    "react-native-svg": "^15.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-native": "^0.86.0",
    "react-native-web": "^0.21.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
